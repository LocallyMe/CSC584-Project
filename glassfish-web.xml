package util;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

/**
 *
 * @Azri
 */

public class DBConnection {
    public static Connection createConnection(){
        Connection con = null;
        try{
            
            Class.forName("org.mariadb.jdbc.Driver");

            // Fixed: Changed 'customers' to 'inventory_db' to match your database
            String URL = "jdbc:mariadb://localhost:3306/lovelle_db";
            String USER = "root";
            String PASSWORD = "";

            con = DriverManager.getConnection(URL, USER, PASSWORD);
            
        } catch (ClassNotFoundException e) {
            System.err.println("MariaDB JDBC Driver missing. Make sure the JAR file is added to your project Libraries!");
            e.printStackTrace();
        } catch (SQLException e) {
            System.err.println("Database connection failed. Check your URL, username, or password.");
            e.printStackTrace();
        }
        return con;
    }
}